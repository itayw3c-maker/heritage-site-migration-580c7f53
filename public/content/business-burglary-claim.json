play:inline-flex;align-items:center;justify-content:center;width:1.3rem;height:1.3rem;border-radius:50%;background:var(--lvbl-accent);color:#fff;font-size:.8rem;font-weight:800;line-height:1;margin-inline-end:.625rem;flex-shrink:0;}<br />\n.lvbl-article .lvbl-num{display:inline-flex;align-items:center;justify-content:center;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--lvbl-accent-soft);color:var(--lvbl-accent);font-size:.9rem;font-weight:700;border:1px solid var(--lvbl-accent-chip-border);margin-inline-end:.7rem;flex-shrink:0;margin-top:.1em;font-variant-numeric:tabular-nums;}<br />\n.lvbl-article blockquote{margin:1.5rem 0;padding:.875rem 1.125rem;border-inline-start:4px solid var(--lvbl-accent);background:var(--lvbl-accent-softer);border-radius:.5rem;color:var(--lvbl-fg);}<br />\n.lvbl-article table{width:100%;max-width:100%;border-collapse:separate;border-spacing:0;margin:1.75rem 0;font-size:1.05rem;line-height:1.6;border:1px solid var(--lvbl-table-border);border-radius:.75rem;overflow:hidden;background:var(--lvbl-card);table-layout:auto;}<br />\n.lvbl-article thead{background:var(--lvbl-accent-soft);}<br />\n.lvbl-article th{font-weight:800;color:var(--lvbl-ink);padding:.9rem 1.1rem;text-align:right;vertical-align:top;border-bottom:2px solid var(--lvbl-table-border);background:var(--lvbl-accent-soft);word-break:normal;overflow-wrap:anywhere;white-space:normal;}<br />\n.lvbl-article td{border-bottom:1px solid var(--lvbl-border);padding:.9rem 1.1rem;text-align:right;vertical-align:top;color:var(--lvbl-fg);word-break:normal;overflow-wrap:anywhere;font-size:1.05rem;}<br />\n.lvbl-article .citation-ref{font-size:.75em;vertical-align:super;margin:0 .15em;}<br />\n.lvbl-article .citation-ref a{display:inline-block;background:var(--lvbl-accent-soft);color:var(--lvbl-accent);font-weight:700;text-decoration:none;padding:.05em .45em;border-radius:.625rem;border:1px solid var(--lvbl-accent-chip-border);font-size:.85em;}<br />\n.lvbl-article hr{border:none;height:1px;background:var(--lvbl-border);margin:2.5rem 0;}<br />\n.lvbl-article .lvbl-faq{margin:1.5rem 0 2.5rem;display:flex;flex-direction:column;gap:1rem;}<br />\n.lvbl-article .lvbl-faq-item{border:1px solid var(--lvbl-border);border-radius:.625rem;background:var(--lvbl-accent-softer);overflow:hidden;}<br />\n.lvbl-article .lvbl-faq-q{display:flex;align-items:center;gap:.875rem;width:100%;padding:1.125rem 1.25rem;cursor:pointer;font-weight:700;font-size:1.15rem;line-height:1.45;color:var(--lvbl-ink);list-style:none;}<br />\n.lvbl-article .lvbl-faq-q::-webkit-details-marker{display:none;}<br />\n.lvbl-article .lvbl-faq-num{display:inline-flex;align-items:center;justify-content:center;width:1.85rem;height:1.85rem;border-radius:50%;background:var(--lvbl-accent-soft);color:var(--lvbl-accent);font-size:.9rem;font-weight:800;flex-shrink:0;border:1px solid var(--lvbl-accent-chip-border);}<br />\n.lvbl-article .lvbl-faq-qt{flex:1;}<br />\n.lvbl-article .lvbl-faq-a{padding:1.1rem 1.25rem 1.35rem;font-size:1.1rem;line-height:1.85;color:var(--lvbl-fg);border-top:1px dashed var(--lvbl-border);}<br />\n.lvbl-article .lvbl-faq-a p{margin:.6rem 0;}<br />\n.lvbl-article .lvbl-glossary{margin:1rem 0 1.5rem;padding:1.2em 1.4em;background:var(--lvbl-accent-softer);border-radius:.625rem;border:1px solid var(--lvbl-accent-chip-border);}<br />\n.lvbl-article .lvbl-glossary dl{margin:0;}<br />\n.lvbl-article .lvbl-glossary dt{font-weight:700;color:var(--lvbl-ink);margin-top:.8em;}<br />\n.lvbl-article .lvbl-glossary dd{margin:.2em 0 0;padding-inline-start:0;color:var(--lvbl-fg);line-height:1.7;}<br />\n.lvbl-article .lvbl-refs{padding-inline-start:1.25rem;}<br />\n.lvbl-article .lvbl-refs li{margin:.5rem 0;line-height:1.7;}<br />\n@media (max-width:640px){<br />\n  .lvbl-article{font-size:1rem;}<br />\n  .lvbl-article h1{font-size:1.6rem;}<br />\n  .lvbl-article .lvbl-h2,.lvbl-article .lvbl-h2-lead{font-size:1.35rem;padding-inline-start:.625rem;}<br />\n  .lvbl-article .lvbl-h2-lead{padding:.75rem .875rem;}<br />\n  .lvbl-article .lvbl-h3{font-size:1.2rem;}<br />\n  .lvbl-article th,.lvbl-article td{padding:.65rem .75rem;font-size:.95rem;}<br />\n  .lvbl-article .lvbl-p-lead,.lvbl-article .lvbl-ul-check{padding:.875rem 1rem;}<br />\n  .lvbl-article .lvbl-faq-q{padding:.875rem 1rem;font-size:1.05rem;}<br />\n  .lvbl-article .lvbl-faq-a{padding:.875rem 1rem 1rem;font-size:1rem;}<br />\n}<br />\n</style>\n<div class=\"lvbl-article\" data-audience=\"businesses\" data-font-scale=\"lg\">\n<p class=\"lvbl-p lvbl-p-lead\">תביעת נזקי פריצה לעסק היא דרישה לפיצוי המוגשת לחברת הביטוח בעקבות התפרצות למקום העסק, הכוללת פיצוי על רכוש שנגנב, על ציוד שניזוק ועל הנזק הפיזי שנגרם למבנה. היקף הפיצוי נקבע לפי תנאי הפוליסה, איכות התיעוד שהמבוטח מספק, ועמידתו בחובות הקבועות בחוק חוזה הביטוח, התשמ\"א-1981. בפועל, אותו אירוע פריצה עשוי להסתיים בפיצוי חלקי או בפיצוי מלא — וההבדל תלוי כמעט תמיד באופן שבו מנוהלת התביעה מהרגע הראשון.</p>\n<h2 id=\"24-shaot\" class=\"lvbl-h2\">מה עושים ב-24 השעות הראשונות</h2>\n<p class=\"lvbl-p\">שלוש הפעולות הראשונות קובעות במידה רבה את גורל התביעה, משום שהן מייצרות את הראיות שעליהן תישען ההוכחה מול חברת הביטוח. חוק חוזה הביטוח מחייב את המבוטח להודיע למבטח על קרות מקרה הביטוח מיד לאחר שנודע לו, ולכן סדר הפעולות בשלב זה אינו עניין של נוחות אלא של עמידה בחובה חוקית.</p>\n<ol class=\"lvbl-ol\">\n<li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">1</span><span class=\"lvbl-li-body\"><strong>דיווח למשטרה.</strong> הזעיקו את משטרת ישראל וודאו שנפתח תיק ושבידיכם מספר האסמכתא. הדוח המשטרתי הוא הראיה המרכזית לכך שמדובר באירוע פלילי; בלעדיו, חברת הביטוח מתקשה לאשר שהתרחשה פריצה ועלולה לדחות את התביעה.</span></li>\n<li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">2</span><span class=\"lvbl-li-body\"><strong>תיעוד לפני נגיעה.</strong> לפני כל ניקוי או סידור, צלמו את סימני ההתפרצות (דלתות וחלונות שנפרצו, מנעולים שנשברו) ואת הרכוש שנגנב או ניזוק. תיעוד שנעשה לפני שינוי מצב הזירה שווה הרבה יותר מכל שחזור מאוחר.</span></li>\n<li class=\"lvbl-li lvbl-li-num\"><span class=\"lvbl-num\" aria-hidden=\"true\">3</span><span class=\"lvbl-li-body\"><strong>הודעה בכתב לחברת הביטוח.</strong> מסרו הודעה מוקדמת ככל האפשר, בהתאם ללוח הזמנים שבפוליסה. תיעוד ההודעה ומועדה מבטיח שלא תיווצר מחלוקת עתידית על עצם הדיווח.</span></li>\n</ol>\n<h2 id=\"arbaa-shlavim\" class=\"lvbl-h2\">ארבעת שלבי הגשת התביעה</h2>\n<p class=\"lvbl-p\">ניהול מסודר של התביעה מחולק לארבעה שלבים. לכל שלב תכלית משפטית או ראייתית משלו, וההקפדה עליו היא שמבדילה בין תביעה שמתנהלת חלק לבין תביעה שנתקעת בדרישות חוזרות.</p>\n<div class=\"lvbl-table-wrap\">\n<table>\n<thead><tr><th>השלב</th><th>מה עושים בפועל</th><th>הבסיס והחשיבות</th></tr></thead>\n<tbody>\n<tr><td><strong>1. הודעה ופתיחת תביעה</strong></td><td>הודעה בכתב על האירוע ומילוי טופס תביעה ייעודי, בצירוף פרטי הפוליסה.</td><td>מקיים את חובת ההודעה שבסעיף 22 לחוק ומתחיל את מירוץ הזמן לבירור החבות.</td></tr>\n<tr><td><strong>2. תיעוד והערכת נזק</strong></td><td>רשימת מלאי מפורטת של הפריטים שנגנבו או ניזוקו, בצירוף חוות דעת שמאי רכוש.</td><td>מכמת את הנזק בצורה שתעמוד מול השמאי מטעם המבטח ומונע פיצוי חסר.</td></tr>\n<tr><td><strong>3. הגשת מסמכים ובירור</strong></td><td>העברת הדוח המשטרתי, חשבוניות ואחריות, תמונות וחוות הדעת לחברת הביטוח.</td><td>ממלא את חובת מסירת המידע שבסעיף 23; במקביל חלה על המבטח החובה לברר את חבותו.</td></tr>\n<tr><td><strong>4. מעקב, משא ומתן והכרעה</strong></td><td>מענה מהיר לדרישות נוספות, בדיקת הצעת הפיצוי וניהול משא ומתן על הפער.</td><td>תגמולים שאינם שנויים במחלוקת משולמים תוך 30 יום (סעיף 27), ואיחור בלתי מוצדק גורר הצמדה וריבית (סעיף 28).</td></tr>\n</tbody>\n</table>\n</div>\n<h2 id=\"habasis-hamishpati\" class=\"lvbl-h2\">מה החוק מחייב — הבסיס המשפטי לתביעת פריצה</h2>\n<p class=\"lvbl-p\">היחסים בין המבוטח לחברת הביטוח אינם נתונים לשיקול דעתה הבלעדי של החברה, אלא כפופים לחוק חוזה הביטוח, התשמ\"א-1981. הכרת ההוראות המרכזיות היא שמאפשרת למבוטח לעמוד על זכויותיו ולזהות מתי דחייה או הפחתה אינן מוצדקות.</p>\n<h3 class=\"lvbl-h3\"><span class=\"lvbl-h3-dot\"></span>חובת ההודעה, ומה קורה אם איחרתם</h3>\n<p class=\"lvbl-p\">סעיף 22 מחייב להודיע למבטח על קרות מקרה הביטוח מיד לאחר שנודע עליו. עם זאת, איחור אינו מוחק אוטומטית את הזכות לפיצוי: סעיף 24 קובע שהמבטח רשאי להפחית מן התגמולים רק אם ההודעה לא נמסרה במועדה ללא סיבה מוצדקת, ורק במידה שהאיחור אכן פגע ביכולתו לברר את חבותו. משמעות הדבר היא שאיחור קצר או מוצדק אינו עילה לשלילת התביעה במלואה.</p>\n<h3 class=\"lvbl-h3\"><span class=\"lvbl-h3-dot\"></span>הסכנה שבניפוח התביעה — סעיף 25</h3>\n<p class=\"lvbl-p\">זהו אחד הסעיפים החשובים ביותר לכל מי שמנהל תביעת פריצה. סעיף 25, שכותרתו \"מרמה בתביעת תגמולים\", קובע שאם המבוטח מסר לחברת הביטוח עובדות כוזבות או העלים עובדות מהותיות — ועשה זאת בכוונת מרמה — פטור המבטח מחבותו. לסעיף שלושה יסודות מצטברים: מסירת עובדות כוזבות, מודעות של המבוטח לכך שהן כוזבות, וכוונה להוציא כספים שלא כדין. הפועל היוצא ברור: הגזמה בהיקף הגניבה או המצאת פריטים שלא היו עלולה להביא לשלילת מלוא הפיצוי, גם על החלק האמיתי של הנזק. תיעוד אמת ומדויק אינו רק המלצה אלא תנאי לקבלת התגמולים.</p>\n<h3 class=\"lvbl-h3\"><span class=\"lvbl-h3-dot\"></span>דחייה בטענת אי-עמידה בתנאי מיגון</h3>\n<p class=\"lvbl-p\">עילת הדחייה הנפוצה בתביעות פריצה היא טענה שהמבוטח לא עמד בתנאי המיגון שנקבעו בפוליסה — למשל אזעקה שלא הופעלה או מנעול שאינו תואם את הנדרש. גם כאן, דחייה גורפת אינה מובנת מאליה. בית המשפט העליון נדרש לשאלה אם הפרת תנאי כזה מבטלת את הכיסוי כליל או מהווה החמרת סיכון לפי סעיף 18 לחוק, המובילה להפחתה יחסית של התגמולים בלבד (רע\"א 9849/17 פיקאלי נ' הכשרה חברה לביטוח). ההבחנה הזו מהותית: פער מסוים במיגון אינו מאיין בהכרח את הזכאות, אלא עשוי להצדיק, לכל היותר, חיוב יחסי.</p>\n<h2 id=\"nezakim-nistarim\" class=\"lvbl-h2\">נזקים נסתרים שנלווים לפריצה</h2>\n<p class=\"lvbl-p\">הנזק הגלוי לעין — הרכוש שנגנב — הוא לרוב רק חלק מהסיפור. פריצה מלווה פעמים רבות בנזקי מבנה, בפגיעה בדלתות ובחלונות, ולעיתים בנזקי רטיבות כתוצאה מפגיעה במערכת אינסטלציה או בנזקי אש אם נעשה שימוש באש בזמן ההתפרצות. נזקים אלה נכללים לרוב בכיסוי הביטוחי, אך נוטים להישכח בעת הגשת התביעה. הערכה כוללת של האירוע דורשת התייחסות גם לתחומים כמו <a href=\"/%D7%A0%D7%96%D7%A7%D7%99-%D7%9E%D7%99%D7%9D-%D7%94%D7%A6%D7%A4%D7%94-%D7%95%D7%A8%D7%98%D7%99%D7%91%D7%95%D7%AA/\">נזקי מים הצפה ורטיבות</a>, <a href=\"/%D7%A0%D7%96%D7%A7%D7%99-%D7%90%D7%A9-%D7%95%D7%A4%D7%99%D7%97/\">נזקי אש ופיח</a> ו<a href=\"/%D7%A9%D7%9E%D7%90%D7%99-%D7%A0%D7%96%D7%A7%D7%99-%D7%94%D7%AA%D7%A0%D7%92%D7%A9%D7%95%D7%AA/\">נזקי התנגשות</a>. כאשר הנזק נגרם בנכס מושכר, נדרשת התייחסות נפרדת ל<a href=\"/%D7%A0%D7%96%D7%A7%D7%99-%D7%A9%D7%95%D7%9B%D7%A8%D7%99%D7%9D/\">נזקי שוכרים</a>.</p>\n<h2 id=\"lama-shamai\" class=\"lvbl-h2\">מדוע כדאי שמאי רכוש בלתי תלוי</h2>\n<p class=\"lvbl-p\">בכל תביעת פריצה פועלים שני שמאים בעלי אינטרסים מנוגדים. השמאי מטעם חברת הביטוח בוחן את הנזק עבור החברה ששילמה את שכרו, ותפקידו לצמצם את חשיפתה. שמאי רכוש פרטי ובלתי תלוי מייצג את המבוטח בלבד: הוא מכמת את הנזק בצורה מקצועית ואובייקטיבית, מנהל את המשא ומתן מול המבטח, ומגיש <a href=\"/%D7%97%D7%95%D7%95%D7%93-%D7%A7%D7%91%D7%99%D7%9C%D7%94-%D7%9E%D7%A9%D7%A4%D7%98%D7%99%D7%AA/\">חוות דעת קבילה משפטית</a> המשמשת בסיס לתביעה ולהליך משפטי במידת הצורך. בתביעות מורכבות או בעלות היקף כספי משמעותי, פער הידע בין המבוטח לחברת הביטוח הוא שמכריע את התוצאה, וליווי של <a href=\"/%D7%A9%D7%9E%D7%90%D7%99-%D7%A0%D7%96%D7%A7%D7%99-%D7%A4%D7%A8%D7%99%D7%A6%D7%94/\">שמאי נזקי פריצה</a> מצמצם אותו.</p>\n<figure class=\"article-video-embed\" style=\"margin: 1.5em 0;\">\n<div style=\"position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000;\"><iframe style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;\" title=\"האם כל נזק בבית או בעסק מחייב שכירת שמאי פרטי? יחד עם עו&quot;ד אליאב רוימי\" src=\"https://www.youtube.com/embed/75iYbbLBBoc\" allowfullscreen=\"allowfullscreen\"></iframe></div><figcaption style=\"text-align: center; font-size: 0.9em; color: #666; margin-top: 0.5em;\">האם כל נזק בבית או בעסק מחייב שכירת שמאי פרטי? יחד עם עו\"ד אליאב רוימי</figcaption></figure>\n<h2 id=\"mi-meachorei\" class=\"lvbl-h2\">מי עומד מאחורי המדריך</h2>\n<p class=\"lvbl-p\">המדריך נכתב על ידי רפאל ריבוח, שמאי רכוש, מייסד ובעלים של רפאל שמאות רכוש. רפאל עוסק בתחום משנת 2019, החל דרכו בחברת ההסדר \"מילגם\" שם טיפל באלפי תביעות של נזקי מים, המשיך במשרד \"גמולב שמאות כללית בע\"מ\", וערך במהלך השנים אלפי הערכות נזק מול חברות הביטוח. במהלך מלחמת \"עם כלביא\" גויס משרדו לשירות קרן הפיצויים של מס רכוש מטעם רשות המיסים. הניסיון הזה — משני צדי המתרס, גם מתוך חברות ההסדר וגם כשמאי פרטי המייצג מבוטחים — הוא הבסיס להמלצות שבמדריך זה.</p>\n<h2 id=\"faq\" class=\"lvbl-h2\">שאלות ותשובות</h2>\n<div class=\"lvbl-faq\">\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">1</span><span class=\"lvbl-faq-qt\">האם פוליסת ביטוח לעסק מכסה נזקי פריצה?</span></summary><div class=\"lvbl-faq-a\"><p>ברוב פוליסות בית העסק קיים פרק המכסה פריצה וגניבה, הן לרכוש שנגנב והן לנזק שנגרם למבנה. הכיסוי כפוף לתנאי הפוליסה ובכללם תנאי המיגון, ולכן חשוב לבדוק את הפוליסה הספציפית ואת הסייגים שבה.</p></div></details>\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">2</span><span class=\"lvbl-faq-qt\">מהו הצעד הראשון לאחר גילוי פריצה לעסק?</span></summary><div class=\"lvbl-faq-a\"><p>דיווח מיידי למשטרה וקבלת מספר תיק, תיעוד מצולם של הזירה והנזק לפני כל נגיעה, והודעה בכתב לחברת הביטוח. סעיף 22 לחוק חוזה הביטוח מחייב להודיע למבטח מיד לאחר שנודע על האירוע.</p></div></details>\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">3</span><span class=\"lvbl-faq-qt\">איחרתי בהודעה לחברת הביטוח — האם איבדתי את הפיצוי?</span></summary><div class=\"lvbl-faq-a\"><p>לא בהכרח. לפי סעיף 24 לחוק, המבטח רשאי להפחית מהתגמולים רק אם ההודעה אחרה ללא סיבה מוצדקת ורק במידה שהאיחור פגע בפועל ביכולתו לברר את החבות. איחור קצר או מוצדק אינו עילה לשלילת התביעה במלואה.</p></div></details>\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">4</span><span class=\"lvbl-faq-qt\">חברת הביטוח טוענת שלא עמדתי בתנאי מיגון — התביעה אבודה?</span></summary><div class=\"lvbl-faq-a\"><p>לא תמיד. השאלה אם הפרת תנאי מיגון מבטלת את הכיסוי כליל או מהווה החמרת סיכון המובילה להפחתה יחסית בלבד (סעיף 18 לחוק) נדונה בפסיקת בית המשפט העליון, ובכללה רע\"א 9849/17 פיקאלי נ' הכשרה חברה לביטוח. פער מסוים במיגון עשוי להצדיק חיוב יחסי ולא דחייה מלאה.</p></div></details>\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">5</span><span class=\"lvbl-faq-qt\">מהי הטעות המסוכנת ביותר בניהול תביעת פריצה?</span></summary><div class=\"lvbl-faq-a\"><p>הגזמה או אי-דיוק בהיקף הנזק. סעיף 25 לחוק קובע שמסירת עובדות כוזבות בכוונת מרמה פוטרת את המבטח מחבותו — כלומר עלולה לשלול את מלוא הפיצוי, גם על החלק האמיתי. יש לתעד את הנזק במדויק ובכנות.</p></div></details>\n<details class=\"lvbl-faq-item\"><summary class=\"lvbl-faq-q\"><span class=\"lvbl-faq-num\">6</span><span class=\"lvbl-faq-qt\">האם כדאי לשכור שמאי רכוש פרטי בכל מקרה?</span></summary><div class=\"lvbl-faq-a\"><p>לא כל תיק מצדיק זאת. בתביעות קטנות וברורות ניתן לעיתים לנהל את התהליך עצמאית, אך בתביעות מורכבות או בעלות היקף כספי משמעותי, שמאי רכוש פרטי בעל היכרות עם נהלי חברות הביטוח משפר משמעותית את סיכויי ההצלחה ואת גובה הפיצוי.</p></div></details>\n</div>\n<h2 id=\"sources-cited\" class=\"lvbl-h2\">מקורות ואסמכתאות</h2>\n<ol class=\"lvbl-refs article-sources lvbl-ol\">\n<li class=\"lvbl-li\"><span class=\"lvbl-li-body\"><a href=\"https://www.nevo.co.il/law_html/law00/71902.htm\" target=\"_blank\" rel=\"noopener noreferrer\">חוק חוזה הביטוח, התשמ\"א-1981</a> — סעיפים 18, 22–25, 27–28 (מאגר נבו).</span></li>\n<li class=\"lvbl-li\"><span class=\"lvbl-li-body\"><a href=\"https://supremedecisions.court.gov.il/Home/Download?path=HebrewVerdicts/17/490/098/e09&amp;fileName=17098490.E09&amp;type=2\" target=\"_blank\" rel=\"noopener noreferrer\">רע\"א 9849/17 פיקאלי נ' הכשרה חברה לביטוח</a> — הבחנה בין חריג בפוליסה לבין החמרת סיכון והפחתה יחסית.</span></li>\n</ol>\n<h2 id=\"disclaimer\" class=\"lvbl-h2\">הבהרה משפטית</h2>\n<p class=\"lvbl-p\">המידע במדריך זה הוא כללי ומיועד להסברה בלבד. אין בו כדי להוות ייעוץ משפטי, חוות דעת שמאית או תחליף לבחינה פרטנית של הפוליסה ונסיבות המקרה. בכל תביעה קונקרטית מומלץ להיוועץ בבעל מקצוע מוסמך.</p>\n<h2 id=\"lvbl-glossary-title\" class=\"lvbl-h2\">מילון מושגים</h2>\n<section class=\"lvbl-glossary\" aria-labelledby=\"lvbl-glossary-title\">\n<dl>\n<dt>פוליסת ביטוח</dt><dd>חוזה בין המבוטח לחברת הביטוח המפרט את הסיכונים המכוסים, תנאי הכיסוי וסכומי הפיצוי.</dd>\n<dt>תנאי מיגון</dt><dd>דרישות הפוליסה להתקנה ולהפעלה של אמצעי הגנה (אזעקה, מנעולים, סורגים) כתנאי לכיסוי נזקי פריצה.</dd>\n<dt>החמרת סיכון</dt><dd>שינוי שמגדיל את הסיכון המבוטח. לפי סעיף 18 לחוק, במקרים מסוימים תוצאתו הפחתה יחסית של התגמולים ולא שלילתם המלאה.</dd>\n<dt>חוות דעת קבילה</dt><dd>מסמך מקצועי הערוך על ידי שמאי מוסמך, העומד בכללי הקבילות ויכול לשמש ראיה בהליך משפטי.</dd>\n<dt>תכולה</dt><dd>הרכוש והציוד שבתוך מבנה העסק — מלאי, ציוד משרדי, מכונות וכדומה.</dd>\n</dl>\n</section>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"@id\":\"https://www.rrshamaut.co.il/business-burglary-claim#article\",\"url\":\"https://www.rrshamaut.co.il/business-burglary-claim\",\"headline\":\"איך לתבוע חברת ביטוח על נזקי פריצה לרכוש עסקי?\",\"name\":\"איך לתבוע חברת ביטוח על נזקי פריצה לרכוש עסקי?\",\"description\":\"מדריך מעשי לתביעת נזקי פריצה לרכוש עסקי מול חברת הביטוח: הצעדים ב-24 השעות הראשונות, שלבי הגשת התביעה, חובות המבוטח לפי חוק חוזה הביטוח התשמ\\\"א-1981, ותפקידו של שמאי רכוש בלתי תלוי במיצוי הפיצוי.\",\"inLanguage\":\"he-IL\",\"keywords\":\"תביעת נזקי פריצה לעסק, פיצוי ביטוח פריצה, שמאי נזקי פריצה, דחיית תביעת ביטוח פריצה, תנאי מיגון, חוק חוזה הביטוח\",\"articleSection\":\"שמאות רכוש וביטוח\",\"wordCount\":1180,\"datePublished\":\"2026-07-20T06:47:52.067Z\",\"dateModified\":\"2026-08-03T00:00:00.000Z\",\"author\":{\"@type\":\"Person\",\"@id\":\"https://www.rrshamaut.co.il/business-burglary-claim#author\",\"name\":\"רפאל ריבוח\",\"jobTitle\":\"שמאי רכוש, מייסד ובעלים\",\"worksFor\":{\"@type\":\"Organization\",\"name\":\"רפאל שמאות רכוש\",\"url\":\"https://www.rrshamaut.co.il\"}},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://www.rrshamaut.co.il#organization\",\"name\":\"רפאל שמאות רכוש\",\"url\":\"https://www.rrshamaut.co.il\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.rrshamaut.co.il/business-burglary-claim\"},\"citation\":[{\"@type\":\"Legislation\",\"name\":\"חוק חוזה הביטוח, התשמ\\\"א-1981\",\"url\":\"https://www.nevo.co.il/law_html/law00/71902.htm\"},{\"@type\":\"CreativeWork\",\"name\":\"רע\\\"א 9849/17 פיקאלי נ' הכשרה חברה לביטוח\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.rrshamaut.co.il/business-burglary-claim#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"האם פוליסת ביטוח לעסק מכסה נזקי פריצה?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"ברוב פוליסות בית העסק קיים פרק המכסה פריצה וגניבה, הן לרכוש שנגנב והן לנזק שנגרם למבנה. הכיסוי כפוף לתנאי הפוליסה ובכללם תנאי המיגון, ולכן חשוב לבדוק את הפוליסה הספציפית ואת הסייגים שבה.\"}},{\"@type\":\"Question\",\"name\":\"מהו הצעד הראשון לאחר גילוי פריצה לעסק?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"דיווח מיידי למשטרה וקבלת מספר תיק, תיעוד מצולם של הזירה והנזק לפני כל נגיעה, והודעה בכתב לחברת הביטוח. סעיף 22 לחוק חוזה הביטוח מחייב להודיע למבטח מיד לאחר שנודע על האירוע.\"}},{\"@type\":\"Question\",\"name\":\"איחרתי בהודעה לחברת הביטוח — האם איבדתי את הפיצוי?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"לא בהכרח. לפי סעיף 24 לחוק, המבטח רשאי להפחית מהתגמולים רק אם ההודעה אחרה ללא סיבה מוצדקת ורק במידה שהאיחור פגע בפועל ביכולתו לברר את החבות. איחור קצר או מוצדק אינו עילה לשלילת התביעה במלואה.\"}},{\"@type\":\"Question\",\"name\":\"חברת הביטוח טוענת שלא עמדתי בתנאי מיגון — התביעה אבודה?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"לא תמיד. השאלה אם הפרת תנאי מיגון מב