# Versioned WordPress migration assets never change in place. Cache them at
# the browser and edge for one year; new uploads use a new path or filename.
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

# Other copied WordPress assets are likewise content-addressed or versioned.
/wp-content/plugins/*
  Cache-Control: public, max-age=31536000, immutable

/wp-includes/*
  Cache-Control: public, max-age=31536000, immutable
