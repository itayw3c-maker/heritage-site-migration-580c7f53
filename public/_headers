# THIS FILE DOES NOTHING HERE. _headers is a Cloudflare Pages feature; this
# site deploys as a Worker with an assets binding, which does not read it.
# Verified 08.09.2026: /wp-content/uploads/ and /fonts/ return no Cache-Control
# at all. The caching that /assets/ does get is the host's own default for its
# hashed build output, not this file.
#
# src/lib/asset-headers.ts holds the intended rules, but it cannot run for
# static files either until the deployment sets assets.run_worker_first - see
# the comment at the top of that file. Kept only to document the intent.
#
# Versioned WordPress migration assets never change in place. Cache them at
# the browser and edge for one year; new uploads use a new path or filename.
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

# Other copied WordPress assets are likewise content-addressed or versioned.
/wp-content/plugins/*
  Cache-Control: public, max-age=31536000, immutable

/wp-includes/*
  Cache-Control: public, max-age=31536000, immutable
